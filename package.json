{
  "name": "pipeline-demo-api",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Express service used to exercise the CI pipeline (SonarQube, Snyk, automated review, Docker build and push).",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageDirectory": "coverage"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lodash": "4.17.11"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "supertest": "^7.1.0"
  }
}
